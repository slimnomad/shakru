{
  "name": "green-asian-wok-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build.mjs && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "pretest": "npm run build",
    "test": "node --test tests/*.test.mjs",
    "format": "prettier --write index.html src/*.css src/*.js scripts/*.mjs tests/*.mjs",
    "test:sites": "node --test tests/sites-worker.test.mjs"
  },
  "dependencies": {
    "vite": "6.4.2"
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  }
}
